# ─── SnapBooth Cloud (Google Drive & Vercel) Environment Variables ───

# ─── METODE 1: Google OAuth 2.0 (SANGAT DIREKOMENDASIKAN untuk Akun Pribadi @gmail.com) ───
# Kuota menggunakan penyimpanan 15GB Google Drive pribadi kamu, bebas error kuota!

# Client ID dari Google Cloud Console (Credentials > OAuth client ID)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Client Secret dari Google Cloud Console
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Refresh Token didapat otomatis setelah kamu klik "Hubungkan Google Drive" di local (atau di web)
# Cukup copy nilai GOOGLE_OAUTH_REFRESH_TOKEN dari file .env local ke Environment Variables Vercel!
GOOGLE_OAUTH_REFRESH_TOKEN=

# ID Folder Google Drive tempat menyimpan hasil foto
# Contoh dari URL: https://drive.google.com/drive/folders/1I02aTnWV0gef2MEh5qEOt-Br9UYzg5Mn
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# PIN / Password untuk masuk ke Panel Admin (/admin.html)
ADMIN_PASSWORD=123456

# ─── METODE 2: Service Account (Opsional - Hanya untuk Google Workspace Shared Drive) ───
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
